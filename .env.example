# Optional: higher GitHub API rate limits (Fine-grained or classic PAT).
# Do not commit real tokens. Copy to .env.local for local dev; set in Vercel for production.
GITHUB_TOKEN=

NEXT_PUBLIC_SITE_URL=https://fazaldin.vercel.app

# Optional: Google Search Console HTML tag verification (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form (Gmail SMTP). Use an App Password on the SMTP account — not your normal login password.
# Send via SMTP_USER; messages arrive at CONTACT_TO (defaults to site email in config).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fazaldinarain08@gmail.com
SMTP_PASS=
SMTP_FROM=fazaldinarain08@gmail.com
CONTACT_TO=fazaldinarain@gmail.com
